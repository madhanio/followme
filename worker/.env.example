# Express Server Configuration
PORT=8000
WORKER_SECRET=your_worker_secret_here

# Automation & Discovery Defaults
GRADE_THRESHOLD=7
CRON_SCHEDULE=0 */12 * * *

# GitHub API Credentials
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username_here

# NVIDIA NIM LLM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here

# Supabase Database Configuration
SUPABASE_URL=https://your_supabase_url_here.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Smart Follow Targeting Config
MAX_OWNER_FOLLOWERS=500
MIN_OWNER_FOLLOWING=10
MAX_OWNER_AGE_DAYS=730
